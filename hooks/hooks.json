{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/usage-hook.mjs\"",
            "timeout": 40
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^connect:usage$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/usage-hook.mjs\"",
            "timeout": 40,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
